<mjml>
  <mj-head>
    <mj-title>Password Changed Successfully</mj-title>
    <mj-attributes>
      <mj-all font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"></mj-all>
      <mj-text font-weight="400" font-size="16px" color="#000000" line-height="26px"></mj-text>
      <mj-class name="mobile-heading" font-size="32px" line-height="40px" />
      <mj-class name="mobile-text" font-size="16px" line-height="26px" />
    </mj-attributes>
    <mj-style inline="inline">
      .body-section {
        border-radius: 12px;
        overflow: hidden;
      }
      a {
        word-break: break-all;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .mobile-heading {
          font-size: 26px !important;
          line-height: 34px !important;
        }
        .mobile-text {
          font-size: 14px !important;
          line-height: 22px !important;
        }
        .mobile-section {
          padding: 40px 20px !important;
        }
        .mobile-wrapper {
          padding: 0 10px !important;
        }
      }
    </mj-style>
  </mj-head>
  
  <mj-body background-color="#f5f5f5" width="600px">
    
    <mj-section full-width="full-width" background-color="#f5f5f5" padding="40px 0 0 0">
      <mj-column width="100%">
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>

    <mj-wrapper padding="0 20px" css-class="body-section mobile-wrapper">
      
      <mj-section background-color="#ffffff" padding="60px 50px" css-class="mobile-section">
        <mj-column width="100%">
           
          <mj-text 
            color="#000000" 
            font-size="32px" 
            font-weight="400" 
            line-height="40px" 
            padding-bottom="30px"
            mj-class="mobile-heading"
            css-class="mobile-heading"
          >
            Hi {{name}},
          </mj-text>
          
          <mj-text 
            color="#000000" 
            font-size="16px" 
            line-height="26px" 
            padding-bottom="40px"
            mj-class="mobile-text"
            css-class="mobile-text"
          >
            Your password has been successfully changed. You can now login to your account with your new credentials.
          </mj-text>

          <mj-button 
            background-color="#000000" 
            align="center" 
            color="#ffffff" 
            font-size="14px" 
            font-weight="600" 
            href="{{loginLink}}" 
            inner-padding="18px 40px"
            border-radius="6px"
            padding="0 0 30px 0"
            letter-spacing="0.5px"
          >
            LOGIN TO ACCOUNT
          </mj-button>

          <mj-text 
            color="#666666" 
            font-size="16px" 
            line-height="26px" 
            padding-bottom="10px"
            mj-class="mobile-text"
            css-class="mobile-text"
          >
             If you did not make this change, please contact us <strong>immediately</strong> at <a href="mailto:support@tmscmt.com" style="color:#000000; text-decoration:underline;">support@tmscmt.com</a> to secure your account.
          </mj-text>

          <mj-text 
            color="#666666" 
            font-size="16px" 
            line-height="26px" 
            padding-top="30px"
            mj-class="mobile-text"
            css-class="mobile-text"
          >
            Thank you,<br/>
            TMS-CMT Team
          </mj-text>

        </mj-column>
      </mj-section>

    </mj-wrapper>

    <mj-section background-color="#f5f5f5" padding="30px 20px 40px 20px">
      <mj-column width="100%">
        <mj-text color="#999999" font-size="12px" align="center" line-height="18px">
          © 2026 CMT TMS. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
    
  </mj-body>
</mjml>